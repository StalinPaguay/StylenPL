
# ==========================================
# CONFIGURACIÓN GENERAL DE STYLEINPL
# ==========================================

APP_NAME=StyleInPL
APP_ENV=development
APP_DEBUG=true

# Prefijo de las rutas de la API
API_V1_PREFIX=/api/v1


# ==========================================
# CONFIGURACIÓN DE MONGODB
# ==========================================

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=styleinpl_db


# ==========================================
# AUTENTICACIÓN Y SEGURIDAD JWT
# ==========================================

# Valor de ejemplo. Generar una clave real en el entorno local.
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256

# Duración del token de acceso en minutos (30 minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================
# ALMACENAMIENTO DE IMÁGENES
# ==========================================

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5


# ==========================================
# CONFIGURACIÓN CORS
# ==========================================

# Origen local del frontend React con Vite
FRONTEND_URL=http://localhost:5173
